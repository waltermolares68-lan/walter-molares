# Copiar a .env.local para desarrollo (NUNCA commitear el archivo real).
# Estos valores son públicos por diseño: se inyectan como GitHub Actions Secrets en producción.

# Project URL de Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon / public key de Supabase (NO la service_role key)
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# WhatsApp del negocio: solo dígitos, con código de país (sin + ni espacios)
VITE_WHATSAPP_NUMBER=5491135834902

# Moneda y formato de precios
VITE_CURRENCY=ARS
VITE_LOCALE=es-AR
